# Environment
NODE_ENV=development

# Server Configuration
PORT=4000
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://ai_unifier:password@localhost:5432/ai_unifier
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
API_KEY_SALT=your-api-key-salt-change-this
ENCRYPTION_KEY=your-32-character-encryption-key-change-this

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# AI Provider API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
HUGGINGFACE_API_KEY=

# Azure OpenAI (if using Azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Provider Configuration
DEFAULT_PROVIDER=openai
ENABLE_PROVIDER_FALLBACK=true
PROVIDER_TIMEOUT_MS=30000

# Caching
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600

# Monitoring
ENABLE_PROMETHEUS=true
PROMETHEUS_PORT=9090
ENABLE_LOGGING=true
LOG_LEVEL=info

# Logging
LOG_FORMAT=json
LOG_FILE_PATH=./logs/app.log

# Email (for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@ai-unifier.local

# Webhook
WEBHOOK_URL=
WEBHOOK_SECRET=

# Plugin System
PLUGIN_DIR=./plugins
ENABLE_PLUGIN_MARKETPLACE=true
PLUGIN_MARKETPLACE_URL=https://marketplace.ai-unifier.dev

# Feature Flags
ENABLE_MULTIMODAL=true
ENABLE_STREAMING=true
ENABLE_BATCH_REQUESTS=true
ENABLE_WEBHOOKS=true

# Security Features
ENABLE_API_KEY_ROTATION=true
API_KEY_ROTATION_DAYS=90
ENABLE_AUDIT_LOGGING=true
ENABLE_IP_WHITELIST=false
IP_WHITELIST=

# Compliance
DATA_RESIDENCY_REGION=us-east-1
ENABLE_GDPR_MODE=false
ENABLE_HIPAA_MODE=false

# Performance
MAX_CONCURRENT_REQUESTS=100
REQUEST_QUEUE_SIZE=1000
ENABLE_REQUEST_DEDUPLICATION=true

# Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
